# Public URL of the deployed site, e.g. https://<user>.github.io/<repo>
# Used for canonical URLs, sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=

# Only for GitHub project pages (https://<user>.github.io/<repo>):
# set to "/<repo>". Leave empty for <user>.github.io or a custom domain.
NEXT_PUBLIC_BASE_PATH=

# Optional Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
